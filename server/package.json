{
  "name": "soundwave-server",
  "version": "1.0.0",
  "description": "Soundwave API — Node.js + Express + PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "psql $DATABASE_URL -f src/db/schema.sql",
    "db:seed": "psql $DATABASE_URL -f src/db/seed.sql",
    "db:reset": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
